#!/bin/sh
# Chặn commit khi lint/build lỗi (vd biến chưa khai báo sót lại sau khi giải quyết conflict).
# Bật một lần: npm install ở thư mục gốc (script "prepare"), hoặc: git config core.hooksPath .githooks
# Bỏ qua khi thật cần: git commit --no-verify
# shortcut: lint/build chạy trên file đang có trong thư mục làm việc, không chỉ phần đã stage.

staged_files=$(git diff --cached --name-only)

if echo "$staged_files" | grep -q '^frontend/'; then
  echo "[pre-commit] frontend: lint + build"
  npm run lint --prefix frontend || exit 1
  npm run build --prefix frontend || exit 1
fi

if echo "$staged_files" | grep -q '^backend/'; then
  echo "[pre-commit] backend: lint"
  npm run lint --prefix backend || exit 1
fi
